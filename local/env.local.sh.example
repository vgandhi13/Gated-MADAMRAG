# Copy to local/env.local.sh (gitignored) and edit. Sourced by baselines/env.sh.
# Large-file root for the venv, caches, results, and temp files.
export GATED_WORK=/path/to/fast/storage/gated
# Python environment created by scripts/setup_baselines.sbatch.
export GATED_ENV="$GATED_WORK/env"
# Local Qwen3-8B checkpoint directory (inference jobs run with HF offline).
export GATED_MODEL=/path/to/models/Qwen3-8B
# Slurm account used by sbatch (source baselines/env.sh before submitting).
export SBATCH_ACCOUNT=your_slurm_account
